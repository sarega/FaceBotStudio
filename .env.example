# OpenRouter API key (server-side only, do not expose in frontend)
OPENROUTER_API_KEY="API_KEY_HERE"

# Facebook Page access token (required for auto-reply on Messenger)
PAGE_ACCESS_TOKEN=""

# Facebook App Secret (recommended for webhook signature verification)
FACEBOOK_APP_SECRET=""

# Optional Graph API version for send-message endpoint
FACEBOOK_GRAPH_API_VERSION="v22.0"

# Default model used if no model is selected in settings
OPENROUTER_DEFAULT_MODEL="google/gemini-3-flash-preview"

# Admin Agent public web research for Press Outreach (set 0 to disable)
ADMIN_AGENT_WEB_SEARCH_ENABLED="1"

# Embedding model used for queued document vectors and retrieval
OPENROUTER_EMBEDDING_MODEL="text-embedding-3-small"

# Optional webhook URL that receives a copy of document embedding payload jobs
EMBEDDING_HOOK_URL=""

# Public app URL (used for webhook callback display and OpenRouter headers)
APP_URL="http://localhost:3000"

# Production database. When set, the app uses PostgreSQL instead of SQLite.
DATABASE_URL=""
# Railway private Postgres uses TLS with an internal certificate chain. Use verify-full only with a trusted CA.
PGSSLMODE="require"
PGPOOL_MAX="10"
# Public registration ticket links. Generate a random secret of at least 32 characters.
TICKET_ACCESS_SECRET=""
# Optional separate secret for short-lived private channel/admin-agent media links.
MEDIA_ACCESS_SECRET=""
# Optional separate secret for browser-bound public event and web chat sessions.
PUBLIC_CHAT_SESSION_SECRET=""
# Redis is required for shared rate limits in production. The default production policy fails closed if Redis is unavailable.
REDIS_URL=""
RATE_LIMIT_FALLBACK_MODE="fail_closed"
# Set to 1 only when deliberately running one web instance without Redis.
RATE_LIMIT_SINGLE_INSTANCE="0"
# Bound provider calls so a stalled external service cannot hold a worker forever.
PROVIDER_REQUEST_TIMEOUT_MS="15000"
LLM_REQUEST_TIMEOUT_MS="60000"
# Direct/VIP ticket security and PromptPay. Generate both ticket secrets independently.
DIRECT_TICKET_SECRET=""
PROMPTPAY_ID=""
PROMPTPAY_RECEIVER_NAME=""
PUBLIC_DIRECT_TICKETING_ENABLED="0"
CUSTOMER_APP_ENABLED="0"
CUSTOMER_ACCOUNT_REGISTRATION_ENABLED="0"
PLATFORM_FEES_ENABLED="0"
BILLING_DOCUMENTS_ENABLED="0"
SCB_PAYMENT_CONFIRMATION_ENABLED="0"
# Optional: enables strict signed callbacks from a slip/payment verification adapter.
DIRECT_PAYMENT_WEBHOOK_SECRET=""

# Transactional email provider API key
RESEND_API_KEY=""

# Outgoing sender identity (supports alias-based senders)
EMAIL_FROM="Event Bot <tickets@example.com>"

# Reply-to address shown to recipients
EMAIL_REPLY_TO="reply@example.com"

# Phase 1 SMS readiness — keep disabled until a ThaibulkSMS account is configured.
SMS_REMINDERS_ENABLED="0"
THAIBULKSMS_API_KEY=""
THAIBULKSMS_API_SECRET=""
THAIBULKSMS_SENDER_NAME=""
# Generic transactional SMS adapter. Keep disabled until a provider endpoint is configured.
SMS_NOTIFICATION_ENABLED="0"
SMS_PROVIDER_URL=""
SMS_PROVIDER_TOKEN=""
SMS_SENDER_ID=""

# Session cookie lifetime in days
SESSION_TTL_DAYS="14"

# Scoped check-in access session lifetime in minutes (5-1440)
CHECKIN_ACCESS_SESSION_TTL_MINUTES="120"

# Max JSON body size for API requests (Express format, e.g. 256kb / 1mb)
JSON_BODY_LIMIT="256kb"
# Maximum time to wait for graceful shutdown before forcing process exit.
SHUTDOWN_TIMEOUT_MS="10000"

# Optional comma-separated extra origins allowed by CSRF origin check
CSRF_ALLOWED_ORIGINS=""

# Express trust proxy setting (recommended: "1" behind one reverse proxy; use "false" if direct)
TRUST_PROXY=""

# Runtime mode: all | web | worker
# Facebook automatic and admin manual replies are delivered by the notification worker. In split mode,
# keep one APP_RUNTIME=worker service running with the same database and Redis.
APP_RUNTIME="all"

# Optional deploy port (most platforms inject this automatically)
PORT="3000"

# SQLite DB file path (for Railway volume use something like /data/bot.db)
DB_PATH="bot.db"

# Public upload storage root (for Railway volume use something like /data/uploads)
PUBLIC_UPLOADS_DIR=""
